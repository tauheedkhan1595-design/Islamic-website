{
  "name": "islamic-editorial-cms",
  "version": "1.0.1",
  "private": true,
  "description": "Modular Islamic editorial website with HTML smart paste editor and SQLite",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "sanitize-html": "2.14.0",
    "slugify": "1.6.6"
  }
}
